            ]
          },
          {
            "id": "player-opening-deer-opponent",
            "section": "前期思路",
            "text": "需要争取前期胜场时，按对手质量选择过渡英雄：对手较弱、牛魔能够取胜时可补经济；面对同行瑶妹或强势孙尚香时，比较用干将莫邪替代牛魔补即时战力。保留用于后续升本和购买核心的预算，不为凑齐过渡名单刷空金币。",
            "condition": "",
            "inference": true,
            "kind": "general_strategy",
            "version": null,
            "origin": "editorial",
            "evidence": [
              {
                "source": "BV1pmap6HELz:p1",
                "start": 31.3,
                "end": 61.46
              },
              {
