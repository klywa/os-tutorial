    },
    {
      "type": "entry",
      "key": "前期",
      "show_key": true,
      "value": "镜像储备消耗经济，前期以保血与资源平衡为主。",
      "prefix": "- **",
      "key_suffix": "：** ",
      "separator": "\n\n",
