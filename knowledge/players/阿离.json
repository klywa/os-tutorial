      "key": "放弃或转向信号",
      "show_key": true,
      "value": "缺遗志或海月时不把完成升级等同成型，优先修正保血与找牌渠道。",
      "prefix": "",
      "key_suffix": "：",
      "separator": "\n\n",
      "id": "n-29dbbd63379c27785d9c"
    },
    {
