    },
    {
      "type": "entry",
      "key": "后期",
      "show_key": true,
      "value": "推测：高等级海月与复活、附身体系到位后可重复兑现牺牲；旧范围伤害数值需按版本区分。",
      "prefix": "- **",
      "key_suffix": "：** ",
      "separator": "\n\n",
      "id": "n-63c18ef699da905aeb98"
    },
