            "selection": {
              "adopt": "可按派对牌和经济升本、五本启动朋友多多找体系时考虑。",
              "avoid": "五本仍无花木兰时先补核心；古币数量多但等级不足时补李白或永久成长。",
              "signals": {
                "来牌与同行": "先检查花木兰、上官婉儿与露娜的获取和公共牌库；同行会争夺露娜。",
                "对手与压力": "先能保住当轮血量，再为后续循环存资源；无统一血量阈值。"
              },
              "stage_strength": {
                "early": {
                  "text": "前期围绕苏烈、李元芳等经济过渡，少花能量刷新并保留升本资源；这一阶段对不同对手的实际相对强度尚待确认，不能仅凭升本节奏认定占优。",
                  "claim_refs": [
                    "n-opening"
                  ],
                  "inference": false
                },
                "middle": {
                  "text": "五本使用朋友多多是集中启动窗口，但随机牌不保证得到花木兰；缺核心时继续升本会延长空窗。启动回合还要及时处理手牌与转瞬古币，技能收益只有转为场上质量才算战力。",
                  "claim_refs": [
                    "n-opening",
                    "n-five-missing",
                    "n-time"
                  ],
                  "inference": true
                },
                "late": {
                  "text": "核心稳住后再升六取得专属强化，配合觉醒和整备资源继续提升；不能把技能参考升本回合当作固定强势期。最终强弱仍取决于核心质量、复生预算及对手威胁。",
                  "claim_refs": [
                    "guide-skills-naonao",
                    "wanner-awaken",
                    "revive-budget"
                  ],
                  "inference": true
                }
              }
            },
            "required_factions": [
              "河洛",
              "日落海"
            ],
            "advantages": "朋友多多找体系，零钱兑换放大古币使用张数。",
            "disadvantages": "破损古币不提供等级；集中启动回合操作密集。"
