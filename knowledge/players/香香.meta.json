          },
          {
            "id": "doc-7d0a7d70dce84b1f7fcf69",
            "section": "适用打法与选择",
            "text": "低费（1-3）阶阵容，推荐大河开团射。",
            "version": null,
            "condition": "",
            "inference": false,
            "kind": "conditional_strategy",
