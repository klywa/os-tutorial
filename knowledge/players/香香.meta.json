            ],
            "origin": "document"
          },
          {
            "id": "doc-03fb4874843dad9e7bf111",
            "section": "适用技巧",
            "text": "战术·蓄势：战斗开始，每秒香香攻击力+10%（香香武器选择的是狙击则优先度拉高）；",
            "version": null,
            "condition": "",
            "inference": false,
            "kind": "conditional_strategy",
            "evidence": [
              {
                "type": "document",
                "source": "doc-e96e88e6d4178796bf3cc82ef22f6ac2a2734fa1dd4eb0086f97fdf3c2d818af",
