              }
            ],
            "origin": "document"
          },
          {
            "id": "doc-5025e3770204a348a0525b",
            "section": "适用技巧",
            "text": "战术·歼灭：击败敌人，全体英雄+ 4级（联动香香被动滚全队等级，场上英雄迅速到10级，持续扩大优势）；",
            "version": null,
            "condition": "",
            "inference": false,
            "kind": "conditional_strategy",
            "evidence": [
              {
