            "section": "技能",
            "text": "技能“究极弩炮”：开局自动武器攻击敌方场上的棋子；场上每1只大于等于10级的1/2/3费卡，香香攻击力+20；",
            "version": null,
            "condition": "",
            "inference": false,
            "kind": "mechanic",
            "evidence": [
              {
                "type": "document",
                "source": "doc-e96e88e6d4178796bf3cc82ef22f6ac2a2734fa1dd4eb0086f97fdf3c2d818af",
