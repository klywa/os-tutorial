          },
          {
            "id": "doc-ef049288be4c13dbf92539",
            "section": "适用技巧",
            "text": "战术·砺刃：每造成500伤害，下回合开始随机一名英雄+ 3级（TOP1，万能强），造成伤害增加英雄等级，六级后场上英雄的等级可以反过来提升香香的伤害；",
            "version": null,
            "condition": "",
            "inference": false,
            "kind": "conditional_strategy",
            "evidence": [
              {
                "type": "document",
                "source": "doc-e96e88e6d4178796bf3cc82ef22f6ac2a2734fa1dd4eb0086f97fdf3c2d818af",
