            "disadvantages": "暂无已确认结论"
          },
          {
            "lineup": "b22-high-zhulu-yingzheng",
            "branch": "owner",
            "title": "高阶逐鹿嬴政",
            "path": "knowledge/lineups/高阶逐鹿嬴政-明先生.md",
            "selection": {
              "stage_strength": {
                "early": {
                  "text": "卦节储能期间需过渡场面保血。",
                  "claim_refs": [
                    "fmt24-owner-e27b4cdf79c3"
                  ],
                  "inference": true
                },
                "middle": {
                  "text": "卦丰找到高阶逐鹿、嬴政40级且启动解决后形成输出窗口。",
                  "claim_refs": [
                    "fmt24-owner-38713054751b"
                  ],
                  "inference": true
                },
                "late": {
                  "text": "持续输出与保护齐备后清场强，反伤和第一轮启动仍是关键限制。",
                  "claim_refs": [
                    "fmt24-owner-98c13f1a34fb"
                  ],
                  "inference": true
                }
              },
              "adopt": "逐鹿可用，能够以血量换储能并兑现缩蓝与保护。",
              "avoid": "组件未齐且承伤不足时走4级先稳路线，避免为多一次卦节连败出局。",
              "signals": {
                "英雄投入": "嬴政40后继续成长，白起常驻而老夫子轮换；鲁班大师停刷后上，傀儡另获最高逐鹿/召唤单位半额临时等级，太乙主要按命运之种威胁选。"
              }
            },
            "required_factions": [
              "逐鹿"
            ],
            "advantages": "暂无已确认结论",
            "disadvantages": "暂无已确认结论"
