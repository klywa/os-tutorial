        "lineup_adaptations": [
          {
            "lineup": "heluo-huamulan",
            "branch": "ying",
            "title": "河洛花木兰",
            "path": "knowledge/lineups/河洛花木兰-嬴律.md",
            "selection": {
              "adopt": "能结合所选战略保血，并能观察全场资源与同行露娜需求时考虑。",
              "avoid": "开放决策会让同行先拿核心，或升本会导致当轮淘汰时，先保质量和自身获取资源。",
              "signals": {
                "来牌与同行": "先检查花木兰、上官婉儿与露娜的获取和公共牌库；同行会争夺露娜。",
                "对手与压力": "先能保住当轮血量，再为后续循环存资源；无统一血量阈值。"
              },
              "stage_strength": {
                "early": {
                  "text": "低压运营需要保血争胜维持等级收益，风险对冲的精简连败开局则承担更高掉血风险；两者不能混用。沉淀收益配资本杠杆偏向积累资源，并不直接代表场上占优，仍要买必要战力。",
                  "claim_refs": [
                    "ying-lowpressure",
                    "ying-first-second-skill",
                    "ying-capital-timing"
                  ],
                  "inference": true
                },
                "middle": {
                  "text": "从过渡输出换到花木兰、补婉儿觉醒时有战力衔接风险。空降人才、首购激励等需要匹配来牌与决策条件；逐步替换原有输出，不能为换阵或等复制一次卖空战力。",
                  "claim_refs": [
                    "ying-early-auction",
                    "ying-first-second-skill",
                    "ying-first-purchase",
                    "ying-contract-bottle"
                  ],
                  "inference": true
                },
                "late": {
                  "text": "体系齐备后，古币出牌循环更容易兑现投资回报，首购可补关键资源；等待淘汰收益或升六仍要先保证自己能存活。决策可能同时帮助对手，资源更多不等于本轮战力必然更强。",
                  "claim_refs": [
                    "ying-return-timing",
                    "ying-six-redistribution",
                    "ying-resource",
                    "revive-budget"
                  ],
                  "inference": true
                }
              }
            },
            "required_factions": [
              "河洛",
              "日落海"
            ],
            "advantages": "战略与决策提供资源、首购复制和体系补强。",
            "disadvantages": "全场决策也会帮助对手，操作与资源时机判断较复杂。"
          }
        ]
      },
      "evidence_report": "knowledge/reviews/棋手升级教学-2026-10-20.json"
