              "start": 663,
              "end": 753.2,
              "frame": "frames/680-0.jpg"
            }
          ],
          "kind": "conditional_strategy"
        },
        {
          "section": "推荐天赋及原因",
          "text": "优先考虑增加人口的天赋：扩编名额、战术模组、扩编高峰、战略中枢。上场英雄更多，可以提高品阶总和，并让更多高品阶英雄受益。\n\n- 荆棘牢笼补充控制；命运图腾适合针对依赖一个主要输出英雄的对手；虚妄转生辅助图腾体系。\n\n- 始祖熊灵可承担前排，受益于全队等级增长和双方上场单位数量差；化为熊灵可利用大河英雄的总等级。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 407.3,
              "end": 547.5,
              "frame": "frames/500-0.jpg"
            }
          ],
          "kind": "general_strategy"
        },
        {
          "section": "推荐天赋及原因",
          "text": "棋手升到六阶后，优先考虑不朽坚冰，为全队增加500生命和60物理、法术攻击。寒潮之势只强化等级最高的单个英雄；本阵容有多个重要英雄，因此更适合全队强化。是否先选经济或减少掉血的天赋，应结合金币和剩余生命判断。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
