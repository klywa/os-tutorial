              "start": 895,
              "end": 1040,
              "frame": "frames/1039-0.jpg"
            }
          ],
          "kind": "general_strategy"
        },
        {
          "section": "核心机制",
          "text": "持续冻结英雄，使其转换为更高品阶的英雄，尽早获得核心英雄。第5、第8回合通过深度冻结选择关键技能分支。提高上场英雄的品阶总和，配合冰心领域增加永久等级；利用图腾和东皇太一的控制，为敖隐及其他输出英雄争取攻击时间。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 0,
              "end": 145,
              "frame": "frames/90-0.jpg"
            }
          ],
          "kind": "mechanic"
        },
        {
          "section": "前期运营及应变",
          "text": "开局使用弈星和孙尚香，持续冻结孙尚香，利用她提供的经济和免费刷新机会；也可使用苏烈，利用其阵亡后增加的等级，让冻结后的英雄继承。\n\n- 如果己方阵容难以战胜当前对手，可以只保留弈星和用于冻结的过渡英雄，卖掉其他英雄，把金币用于提升棋手等阶。过渡英雄被冻结并转换后，继续冻结该位置的新英雄。\n\n- 如果对手阵容较弱、补一个英雄就有机会获胜，可以加入干将莫邪，争取连胜并减少掉血。寻找普通三品阶英雄时，优先使用免费刷新，不额外花金币刷新商店。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 753.5,
              "end": 894.7
            }
          ],
          "kind": "conditional_strategy"
        },
        {
          "section": "中期运营及应变",
          "text": "第5回合优先选择霜寒进化或冰封结晶，帮助获取高品阶英雄。选择霜寒进化时，可以保留四品阶的大河英雄刘邦或韩信，冻结后定向寻找东皇太一或敖隐。\n\n- 尽快将棋手升到五阶，再花金币刷新商店寻找核心英雄。东皇太一到场但人口已满时，可以卖掉弈星腾出位置。\n\n- 购买商店里的三、四品阶英雄继续冻结；若冻结得到的五品阶英雄不是东皇太一或敖隐，可以继续冻结，寻找所需核心。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 85.1,
              "end": 174.8
            }
          ],
          "kind": "conditional_strategy"
        },
        {
          "section": "中期运营及应变",
          "text": "如果迟迟没有获得虞姬，不必一直等待：可以先用司空震或海月承担输出，再寻找东皇太一和敖隐。同时保留能提供图腾的英雄。第8回合选择冰心领域，增加全队永久等级。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 1543.6,
              "end": 1933.4,
              "frame": "frames/1840-0.jpg"
            }
          ],
          "kind": "conditional_strategy"
        },
        {
          "section": "后期运营及应变",
          "text": "核心英雄和图腾体系齐备后，利用每回合自动增长的等级继续发育，积攒金币将棋手升到六阶并选择不朽坚冰。虞姬等级较低且已获得司空震时，可以直接替换虞姬。张良积累较多永久等级后，可以用传承、遗志将等级转给后续输出英雄或太乙真人，再让太乙真人附身东皇太一。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 951,
              "end": 1097.8
            }
          ],
          "kind": "general_strategy"
        },
        {
          "section": "成型后提升思路",
          "text": "阵容成型后，优先增加人口上限、全队等级和装备。司空震可以利用队友的临时等级，适合装备金色圣剑。随后重点保护图腾、完成核心英雄觉醒，并根据对手阵容决定用众星拱月强化谁；核心齐备后，无需为寻找英雄而反复冻结。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 951,
              "end": 1038.7
            }
          ],
          "kind": "general_strategy"
        },
        {
          "section": "第一轮拍卖",
          "text": "第一轮拍卖优先少司缘、鬼谷子等能提供图腾的英雄；没有合适的图腾英雄时，可选择虞姬、张良、云中君或瑶等大河英雄。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 836.5,
              "end": 894.7
            }
          ],
          "kind": "general_strategy"
        },
        {
          "section": "第二轮拍卖",
          "text": "第二轮拍卖时，如果还缺核心英雄，优先补东皇太一或敖隐。敖隐本身已有吸血能力，不必重复配置吸血装备。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
              "source": "BV1aThi6AEAC:p1",
              "start": 1693.5,
              "end": 1853.9
            }
          ],
          "kind": "conditional_strategy"
        },
        {
          "section": "第三轮拍卖",
          "text": "优先选择新生力量，增加人口上限。如果缺少主要输出英雄，可以选择神兵天降；破境之证、众星拱月、众星闪耀也可根据阵容需要选择。\n\n- 如果当前阵容能够继续赢下对局，可以暂不使用众星闪耀，让其持有收益继续增长。\n\n- 天籁琴音帮助英雄觉醒；一线生机用于获得名刀·司命。\n\n- 狂飙三倍速、展翅腾飞可以等待其他玩家结束竞价后，再尝试低价竞拍。",
          "version": "视频发布于2026-09-21；具体游戏版本未确认",
          "condition": "",
          "inference": false,
          "evidence": [
            {
