      }
    },
    {
      "id": "b22-b22-prep-hanxin-owner-hero-1671",
      "section": "英雄",
      "text": "**孙悟空：** 额外位置下的整备工具，当前用途不必夺取其他核心等级；成型过程可临时上场，再为关键保护位腾位置。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1H7aP6FEgZ:p1",
