      }
    },
    {
      "id": "b22-b22-prep-hanxin-owner-equipment",
      "section": "推荐装备",
      "text": "韩信以凝渊、无尽巨剑与机爪提供暴击、移速和爆发攻速；没有机爪时比较红叉或金色圣剑。完美演出未开启前先补实际吸血、免控缺口，开启后再比较纯输出。百锻刀可替换无尽，保留凝渊的追击价值；瑶可分发名刀和近卫荣耀。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1H7aP6FEgZ:p1",
          "start": 859.31,
          "end": 1003.82
        }
      ]
    },
    {
      "id": "b22-b22-prep-hanxin-owner-talents",
      "section": "推荐天赋及原因",
      "text": "经济服务升4级找韩信，人口允许更多开团、整备工具并保留打出位。双生相提高闪现英雄暴击，虚妄转生可形成额外高等级韩信；具体采用仍看主力已经养成且能兑现复制。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1H7aP6FEgZ:p1",
          "start": 141.82,
          "end": 304.0
        }
      ]
    },
    {
      "id": "b22-b22-prep-hanxin-owner-effects",
      "section": "关键效果牌",
      "text": "首张韩信之后再比较临阵磨枪、全军动员触发整备，跳级回收阿科米亚核心等级。梦奇、蒙犽、庄周、甄姬等可增加有效打牌，但装备牌与锦囊本体不能冒充钦定主角计数。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1H7aP6FEgZ:p1",
          "start": 0,
          "end": 57.51
        }
      ],
