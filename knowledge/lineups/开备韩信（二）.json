      }
    },
    {
      "id": "b22-b22-prep-hanxin-owner-hero-1861",
      "section": "英雄",
      "text": "**太乙真人：** 后期保护位，缺人口时先留手，准备转战斗或进入决赛再上；觉醒回手形成空间时继续利用打牌成长。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1H7aP6FEgZ:p1",
