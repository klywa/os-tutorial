      }
    },
    {
      "id": "b22-b22-prep-hanxin-owner-auction3",
      "section": "第三轮拍卖",
      "text": "韩信未觉醒时优先比较天籁琴音，已觉醒则可补太乙真人；再按主力等级、人口、保血与升级缺口比较破境之证、众星拱月、新生力量、一线生机和能量牌。",
      "condition": "",
      "version": null,
      "inference": false,
