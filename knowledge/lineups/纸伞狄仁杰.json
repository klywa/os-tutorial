        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-a3b27a4a288eef3864cabb",
      "section": "后期运营及应变",
      "text": "血量健康升棋手到6级，配合阿离的伞强化狄仁杰提升上限。棋手6级后，阿离技能选择\"翩跹馈赠’，普攻满15次获得1次转移。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
