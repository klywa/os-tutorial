      "origin": "document"
    },
    {
      "id": "doc-77edc10c7710825cade4be",
      "section": "前期运营及应变",
      "text": "拍卖优先拿狄仁杰>程咬金>盾山>明世隐>阵容牌",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
          "source": "doc-a9140a94d5b9dbe6580c87aa00f2679808a404499bbd2aaa1c15d58a31c1f9e7",
