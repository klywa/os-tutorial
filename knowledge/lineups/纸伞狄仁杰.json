    {
      "id": "doc-70383829c7b4a2168f348b",
      "section": "中期运营及应变",
      "text": "拍卖优先拿太乙真人>阵容牌",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
