          "paragraph_start": 24,
          "paragraph_end": 24
        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-e68fce3adfc9ca43dad84d",
      "section": "中期运营及应变",
      "text": "优先觉醒狄仁杰和铠；拿到“唤醒”效果牌给明世隐用，“临阵磨枪”给李元芳或程咬金。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
          "source": "doc-a9140a94d5b9dbe6580c87aa00f2679808a404499bbd2aaa1c15d58a31c1f9e7",
