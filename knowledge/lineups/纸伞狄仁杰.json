          "paragraph_start": 29,
          "paragraph_end": 29
        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-dde043fe5b8bb90d32efee",
      "section": "后期运营及应变",
      "text": "拍卖未满六级优先拿扶摇直上>能量超新星，其次缺装备选择装备合成卡、一线生机。",
      "version": null,
