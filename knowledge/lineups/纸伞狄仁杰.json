      ],
      "origin": "document"
    },
    {
      "id": "doc-a42ae7dbdf2dc19ea5b74a",
      "section": "中期运营及应变",
      "text": "棋手升至3级，刷出阵容牌。有一定战力后即可存钱升级。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
