          "source": "doc-a9140a94d5b9dbe6580c87aa00f2679808a404499bbd2aaa1c15d58a31c1f9e7",
          "paragraph_start": 26,
          "paragraph_end": 26
        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-30eb969f7edcbec3fc4d58",
      "section": "后期运营及应变",
      "text": "存钱升级，补齐阵容后，李元芳、太乙真人、明世隐3个都连接狄仁杰。决赛李元芳可换成钟馗。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
          "source": "doc-a9140a94d5b9dbe6580c87aa00f2679808a404499bbd2aaa1c15d58a31c1f9e7",
