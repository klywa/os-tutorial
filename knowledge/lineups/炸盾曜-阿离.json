    },
    {
      "type": "entry",
      "key": "放弃或转向",
      "show_key": true,
      "value": "无法稳定施法或转移落点被利用时，先解决免控、缩蓝和接敌。",
      "prefix": "**",
      "key_suffix": "**：",
