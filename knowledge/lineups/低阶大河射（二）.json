      }
    },
    {
      "id": "b22-b22-low-dahe-shoot-owner-talents",
      "section": "推荐天赋及原因",
      "text": "经济与供牌收益用于频繁合成，战力与吸血帮助双核延续输出。人口只需补实际缺口，不为昂贵人口挤占合成资源；多个低阶英雄已在场时可比较小咖秀。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1cZhE6NE4t:p1",
