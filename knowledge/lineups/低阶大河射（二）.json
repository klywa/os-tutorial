      }
    },
    {
      "id": "b22-b22-low-dahe-shoot-owner-hero-1751",
      "section": "英雄",
      "text": "**钟馗：** 决赛工具位，在处理退场工具等级后补入；不是开局固定占位。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1cZhE6NE4t:p1",
