  "claims": [
    {
      "id": "b22-b22-low-dahe-shoot-owner-principle",
      "section": "核心原理",
      "text": "猪八戒在前排承伤成长，公孙离利用击退和远程普攻输出，形成双核。嬴律以低压运营的团队等级或基层提拔的低阶英雄等级帮助前中期取得质量优势，随后用合成与夺取把过渡英雄等级集中给双核。云中君配合瑶、鬼谷子的装备分发定向增加成长，张良补压制；这套打法依赖双核实际战力，区别于靠全队等级强化棋手火力的香香开团射。",
      "condition": "",
