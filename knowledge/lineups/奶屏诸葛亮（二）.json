          "end": 436.5
        }
      ]
    },
    {
      "id": "b22-b22-heal-wall-zhuge-owner-auction2",
      "section": "第二轮拍卖",
      "text": "优先杨玉环，其次诸葛亮，再比较太乙真人、吕布；五阶治疗核心更难补时先确保其到手。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1yMeq6wEGc:p1",
