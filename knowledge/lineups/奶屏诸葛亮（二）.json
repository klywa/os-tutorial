      }
    },
    {
      "id": "b22-b22-heal-wall-zhuge-owner-hero-1141",
      "section": "英雄",
      "text": "**刘禅：** 提供团队临时等级，与明世隐配合养杨玉环；补出觉醒后不以继续搜同名牌挤占核心找牌资源。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1yMeq6wEGc:p1",
