          "end": 1101.1
        }
      ]
    },
    {
      "id": "b22-b22-heal-wall-zhuge-owner-counter",
      "section": "制敌手段",
      "text": "对远程弹道输出，依靠2级以上屏障先拦伤害并用治疗维持。对近战和刺客则用横向封路、弹簧与陷阱延缓接敌；保护被突破后，单靠额外吸血未必能维持原循环。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
