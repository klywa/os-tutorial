      }
    },
    {
      "id": "b22-b22-heal-wall-zhuge-owner-hero-1821",
      "section": "英雄",
      "text": "**干将莫邪：** 觉醒后承担前期输出与击败成长，后期仍可作为高频施法的远程成员，为诸葛亮提供触发；剩余回蓝装备可分给干将。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1yMeq6wEGc:p1",
