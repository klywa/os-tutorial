    {
      "id": "b22-b22-heal-wall-zhuge-owner-machinery",
      "section": "关键操作",
      "text": "让敌人先触发陷阱、弹簧再拆屏障，以取得螺丝。2级屏障能阻挡弹道，1级主要限制近战路线；多个屏障横向展开堵住绕行，先普遍升2级。敌方有刺客时预留诱导落点配弹簧，避免刺客直接进入核心群。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
