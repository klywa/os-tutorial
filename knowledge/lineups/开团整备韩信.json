    },
    {
      "id": "doc-2c94b092353cb09791ecf3",
      "section": "推荐装备",
      "text": "瑶：破茧之衣 + 近卫荣耀",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
