    {
      "type": "heading",
      "level": 2,
      "title": "核心机制",
      "space": " ",
      "separator": "\n\n",
      "id": "b77-h-c18d73d8f908c2ac4d"
    },
    {
      "type": "entry",
      "key": "正文",
      "show_key": false,
      "value": "待确认",
      "prefix": "",
