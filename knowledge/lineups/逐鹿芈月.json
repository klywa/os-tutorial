  "claims": [
    {
      "id": "b22-b22-zhulu-miyue-owner-principle",
      "section": "核心原理",
      "text": "芈月施法后由暗影仆从连续攻击、治疗并偷取抗性，把承伤时间转成越来越有利的持久战。姜导在使用效果牌时供给额外资源，孙膑与逐鹿成长继续提高芈月等级；西施缩蓝让仆从尽早启动，程咬金承担启动前的伤害。因而找齐启动与前排，比只堆芈月等级更重要。",
      "condition": "",
      "version": null,
