      }
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-hero-1321",
      "section": "英雄",
      "text": "**马可波罗：** 仅在崛起与双生突袭的配套路线补入，与守约共战产生额外技能分身；没有该配套时不固定占用原工具位。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 409.02,
          "end": 492.43
        }
      ],
      "review_basis": {
        "snapshot": "knowledge/reviews/22份文字稿融合-2026-10-22.json"
      }
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-skills",
      "section": "棋手技能推荐",
      "text": "枫华之刃提高狙击伤害，枫灵涌动补施法间隙，一叶双生争取输出环境；缺吸血时优先比较斗转星移。对方人口多时比较踏叶摘星，人口少时比较瞬步无影。6级用枫之洪流，守约主要施法，依赖普攻次数的馈赠不宜照搬。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 114.05,
          "end": 292.13
        }
      ]
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-talents",
      "section": "推荐天赋及原因",
      "text": "经济和复印机帮助低阶组件成型，人口可多挂河洛工具。崛起能衔接双生突袭，是独立配套方向；最终守卫借多次牺牲延长守约存活。没有斗转星移时，比较微弱优势、强者恒强等吸血渠道；末世主要依赖普攻，不适合当作守约固定神器。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 292.13,
          "end": 694.1
        }
      ]
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-equipment",
      "section": "推荐装备",
      "text": "无尽巨剑提高狙击爆发，控制多时用炽热支配者保证较长施法动作不被打断。对反伤或爆发可补名刀·司命；缺保护需求时再比较双无尽或魔律之刃。百锻刀随收割成长，吸血神器优先补实际缺口。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 1265.07,
          "end": 1380.72
        }
      ]
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-effects",
      "section": "关键效果牌",
      "text": "守约到手后可用古币多多、简易协作、精密协作提高等级，觉醒的产币成员可借临阵磨枪再次触发。武装分解用于清理其他位置无效装备找神器，夺命之护仅在对方控制少、可让出免控格时比较。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 694.1,
          "end": 778.02
        }
      ]
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-auction1",
      "section": "第一轮拍卖",
      "text": "优先铠，再比较程咬金、盾山、钟馗与明世隐；顺序服务于牺牲启动和成长配套。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 1070.24,
          "end": 1101.57
        }
      ]
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-counter",
      "section": "克制手段",
      "text": "名刀·司命、磐石之心和多次复生会削弱一枪收割与续续输出；反伤可能在守约狙出高伤害时反杀。先检查能否保住下一枪、避开近身威胁，再调整免控、名刀与站位。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1hRem66EMw:p1",
          "start": 1265.07,
          "end": 1380.72
        }
      ],
      "review_basis": {
        "snapshot": "knowledge/reviews/22份文字稿融合-2026-10-22.json"
      }
    },
    {
      "id": "b22-b22-umbrella-shouyue-owner-paired-talent",
      "section": "主要变阵",
      "text": "取得崛起后，可让马可波罗与百里守约共战，继续争取双生突袭：施法创造分身再施法，使守约形成双狙。采用条件是实际取得成套天赋并能安排马可波罗的位置，不能把只拿崛起当作已经获得双生；仍先解决原来的牺牲缩蓝、吸血和存活。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
