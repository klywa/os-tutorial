      }
    },
    {
      "id": "b22-b22-umbrella-haiyue-owner-auction",
      "section": "第二轮拍卖",
      "text": "优先海月；缺海月时可比较吕布、姜子牙作为不同转核方向，不把替代英雄直接写进海月固定组成。遗志未取得时，化铁为金只是随机转核的备选，不能保证转出海月。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV181eu6AEfj:p1",
