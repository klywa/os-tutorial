      }
    },
    {
      "id": "b22-b22-umbrella-haiyue-owner-skills",
      "section": "棋手技能推荐",
      "text": "红叶染锋服务干将转海月，枫华之刃补伤害，一叶双生通过分身嘲讽争取输出空间；枫佑永驻和增加转移次数的选项提高护盾收益。海月不优先吸血、回血强化；枫灵涌动或枫之洪流改善施法，落影汲取则受伞落点附近敌人影响。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV181eu6AEfj:p1",
          "start": 465.13,
          "end": 718.85
        }
      ],
      "review_basis": {
        "snapshot": "knowledge/reviews/22份文字稿融合-2026-10-22.json"
      }
    },
    {
      "id": "b22-b22-umbrella-haiyue-owner-talents",
      "section": "推荐天赋及原因",
      "text": "永不独行、小咖秀增加低等级合成与锦囊机会，帮助找遗志；中期转核前存在空窗，防御领域、泉水、紧急救援可提高容错。四海来援适用于海月路线，护命灵珠改善护盾和生存；不把海月受限的回复当作吸血天赋收益。",
      "condition": "",
      "version": null,
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV181eu6AEfj:p1",
          "start": 721.04,
          "end": 1007.46
        }
      ]
    },
    {
      "id": "b22-b22-umbrella-haiyue-owner-equipment",
      "section": "推荐装备",
      "text": "海月比较不死鸟之眼、霸者重铠及护命灵珠，以护盾和承伤为主；需要更多主动施法时补解控。瑶可用名刀·司命和近卫荣耀保住脱离后的存活，红莲炎甲可随附身提供降疗。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV181eu6AEfj:p1",
