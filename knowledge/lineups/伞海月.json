      }
    },
    {
      "id": "b22-b22-umbrella-haiyue-owner-operation",
      "section": "关键操作",
      "text": "遗志前清理多余接收者；红叶染锋需要在过渡英雄退场前已经取得。干将退场释放枫叶舞后，主动把枫叶舞指定到海月；不能只转等级而忘记转伞。海月到手但尚未取得遗志时，仍可保留干将成长与合成渠道。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV181eu6AEfj:p1",
          "start": 1670.11,
          "end": 1786.02
        }
      ],
      "review_basis": {
