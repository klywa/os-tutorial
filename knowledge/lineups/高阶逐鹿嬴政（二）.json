  "claims": [
    {
      "id": "b22-b22-high-zhulu-yingzheng-owner-principle",
      "section": "核心原理",
      "text": "嬴政持续施法清场，西施缩蓝解决启动，芈月和效果牌提供逐鹿成长，白起护盾帮助主力活到输出。明先生用卦节储能，再用卦丰降低付费刷新成本，把能量转换为高阶组件和重复牌；因此可按血量选择4级先稳场或5级再找牌。棋手经济优势需要先兑现启动、免控与生存，才会成为嬴政的持续伤害。",
      "condition": "",
      "version": null,
      "inference": true,
      "kind": "conditional_strategy",
