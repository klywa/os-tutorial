    {
      "id": "doc-8309030fc84ea50139d846",
      "section": "核心机制",
      "text": "镜作为钦定主角后，封神一瞬留给镜；当回合被动供级达到上限且暂不缺战力时，部分牌可留到下回合，避免浪费后续出牌成长。",
      "version": null,
      "condition": "",
      "inference": true,
      "kind": "conditional_strategy",
