    },
    {
      "id": "doc-ddd13bdabcb33003ae0c6d",
      "section": "推荐装备",
      "text": "苍：破晓",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
          "source": "doc-ad422be659dd9358c3aaba3c3beefa992e63b34e74b0daa71f875254f0c33106",
          "paragraph_start": 12,
          "paragraph_end": 12
        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-7137d62f872b7f892b11d9",
      "section": "推荐装备",
      "text": "朵莉亚：法源之杯保证回蓝",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
