    {
      "id": "bex-44b3e47b0bb0600b5",
      "type": "entry",
      "key": "孙尚香（核心/过渡）",
      "show_key": true,
      "value": "按英雄字段补首张、重复与觉醒，拍卖出价上限未确认。",
      "separator": "\n\n"
    },
    {
      "id": "bex-33af8a6d39cf0fcb7",
      "type": "entry",
