        {
          "type": "document",
          "source": "doc-25f57284a72a040d4e72508a3d2c4c4937ce4158463acc805209c1788131606a",
          "paragraph_start": 19,
          "paragraph_end": 19
        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-b5835c0e777ae1b2c08a9e",
      "section": "棋手技能推荐",
      "text": "将枫叶舞给曜，更换主要输出后重新指定，利用其击杀推进秘技；强化选择与该英雄的普攻或技能伤害方式相符，不把所有强化优先级照搬给不同核心。",
      "version": null,
