  "claims": [
    {
      "id": "b22-b22-shield-yao-owner-principle",
      "section": "核心原理",
      "text": "曜频繁施法获得护盾，扁鹊把破盾转成附近范围法术伤害；孙膑、合成和枫叶舞击败成长提高曜等级。阿离的转移护盾与落影汲取同时补生存和爆发，击败更多敌人又能争取额外转移，适合前中期滚雪球。西施缩短曜的法力上限，墨子积累生命上限，分别提高放盾频率与炸盾伤害。",
      "condition": "",
      "version": null,
