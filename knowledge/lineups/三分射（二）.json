  "claims": [
    {
      "id": "b22-b22-sanfen-shoot-owner-principle",
      "section": "核心原理",
      "text": "赵云、曹操承伤，公孙离利用团队觉醒数提高攻速并承担远程输出。曹操触发孙尚香和赵云的登场，补刷新与等级；蔡文姬、猪八戒和低阶合成继续提供成长，等级再由公孙离夺取回收。白歌把合成转成即兴创作和灵感爆发，增加关键低阶牌与觉醒进度，因此重点是持续兑现二阶合成，不把猪八戒当成另一名主力来养。",
      "condition": "",
