      "key": "正文",
      "show_key": false,
      "value": "暂无已确认的通用策略",
      "separator": "\n\n"
    },
    {
      "id": "bs3-81d0b2ea31659e5df2",
      "type": "heading",
      "level": 3,
      "title": "第三轮拍卖",
      "space": " ",
