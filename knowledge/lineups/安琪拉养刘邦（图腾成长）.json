  "claims": [
    {
      "section": "阵容组成",
      "text": "使用安琪拉，以刘邦为核心；鬼谷子、少司缘、大司命提供图腾，明世隐负责等级转化，瑶提供辅助。完整推荐搭配扁鹊增强炸盾伤害，五阶增加人口后补上；逐鹿被禁时无法获取这一关键辅助。明世隐来得少或晚时可改用云中君，决赛阶段再考虑太乙真人。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "general_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1105.19,
          "end": 1273.85,
          "frame": "frames/1255-0.jpg"
        }
      ],
      "id": "claim-ca41a6fe1cd653becafa"
    },
    {
      "section": "禁用阵营适用情况",
      "text": "禁逐鹿时无法上扁鹊，失去炸盾伤害，无法组成本文完整推荐阵容；作者示范局虽然继续靠高等级刘邦普攻取胜，但也指出来牌特别顺、参考价值有限，不能据此认定禁逐鹿后仍能稳定成型。",
      "version": null,
      "condition": "禁逐鹿时",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 2481.7,
          "end": 2691.7
        }
      ],
      "id": "claim-71d24f7eedf6711ca743"
    },
    {
      "section": "核心机制",
      "text": "刘邦在开团时摧毁图腾获取永久等级，尽早觉醒能提高成长收益。安琪拉的飞行器补充临时等级和持续法伤；明世隐及唤醒帮助把临时等级转为永久等级，形成持续成长。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "mechanic",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1164.37,
          "end": 1273.85,
          "frame": "frames/1255-0.jpg"
        }
      ],
      "id": "claim-b33183c05dd0de57e317"
    },
    {
      "section": "核心机制",
      "text": "使用明世隐时可配合唤醒反复触发登场，将飞行器提供的临时等级转为永久等级。明世隐及唤醒来得多时，这条路线优于云中君替代；来得少或晚时，再用云中君补成长。",
      "version": null,
      "condition": "拥有明世隐及唤醒",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1767.1,
          "end": 1796.08,
          "frame": "frames/1790-0.jpg"
        }
      ],
      "id": "claim-9393479509a53e516912"
    },
    {
      "section": "前期运营及应变",
      "text": "开局优先干将莫邪、牛魔：牛魔扛前排，飞行器连接干将莫邪补输出；第二回合补弈星，第三回合开始提升棋手等阶。不要在二、三阶长时间停留，尽快到四阶寻找刘邦和图腾组件。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "general_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1105.19,
          "end": 1162.85,
          "frame": "frames/1115-0.jpg"
        }
      ],
      "id": "claim-c4c4113df9b0d149d5f9"
    },
    {
      "section": "中期运营及应变",
      "text": "首张刘邦到场前，明世隐、鬼谷子、少司缘、大司命各拿一张即可，优先留资源找核心。首张刘邦到场后可以多拿明世隐，三个图腾英雄仍各留一张；刘邦觉醒后也不必为了这三个图腾英雄的觉醒继续花钱。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "general_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1164.37,
          "end": 1220.32,
          "frame": "frames/1180-0.jpg"
        }
      ],
      "id": "claim-36a64baf419544118526"
    },
    {
      "section": "中期运营及应变",
      "text": "四阶找到首张刘邦后升五阶，利用增加的人口补扁鹊，并提高寻找刘邦的机会。五阶连续刷新仍不来刘邦时，考虑停止消耗金币、存钱升六，先用超级连接的临时等级和额外模块稳住，再继续寻找觉醒，不要在五阶耗尽资源。",
      "version": null,
      "condition": "五阶连续刷新仍不来刘邦时",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1193.39,
          "end": 1332.45
        }
      ],
      "id": "claim-34ce45f76864349fb218"
    },
    {
      "section": "后期运营及应变",
      "text": "明世隐来得少或晚时可以用云中君替代；云中君适合追觉醒，并配足装备发挥成长。七人口、进入决赛且等级积累已较充分时，考虑将明世隐或云中君的位置换成太乙真人；人口更多时可以保留成长工具。",
      "version": null,
      "condition": "明世隐来得少或晚时",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1249.38,
          "end": 1304.71,
          "frame": "frames/1265-0.jpg"
        }
      ],
      "id": "claim-4047c5c02ecf461d3be8"
    },
    {
      "section": "后期运营及应变",
      "text": "有扁鹊且仍在积累等级时，先保留扁鹊提供炸盾伤害；最后几回合再考虑用太乙真人替换明世隐，并争取觉醒后的完美复生。不要过早用太乙真人占掉扁鹊的伤害位置。",
      "version": null,
      "condition": "有扁鹊且仍在积累等级时",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 3104.3,
          "end": 3256.6
        }
      ],
      "id": "claim-7d8d9b36fdf5e419a58b"
    },
    {
      "section": "成型后提升思路",
      "text": "优先让刘邦尽早觉醒，再积累图腾等级；安琪拉六阶的超级连接能额外给模块，并按连接英雄自身等级的10%–30%随机提供临时等级，因此速六对这套高等级单核阵容很关键。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "general_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1054.76,
          "end": 1104.9
        }
      ],
      "id": "claim-422443c0323fc3e782b9"
    },
    {
      "section": "成型后提升思路",
      "text": "后期可用夺取之术把工具英雄的等级集中给刘邦；虚妄转生提供虚妄图腾，开团被摧毁后召唤己方最高等级英雄（应确保刘邦为最高等级），本阵容可借此增加一个高等级刘邦。",
      "version": null,
      "condition": "后期",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1736.62,
          "end": 1825.01,
          "frame": "frames/1755-0.jpg"
        }
      ],
      "id": "claim-41e5ef7849bdfc174252"
    },
    {
      "section": "第一轮拍卖",
      "text": "优先鬼谷子、少司缘等图腾英雄，鬼谷子在升高阶后较难寻找，因此优先级更高；随后考虑明世隐、云中君、瑶，缺少这些组件时再考虑梦奇等经济英雄。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "general_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1133.78,
          "end": 1162.85,
          "frame": "frames/1145-0.jpg"
        }
      ],
      "id": "claim-371431ceb961c099b5fa"
    },
    {
      "section": "第三轮拍卖",
      "text": "刘邦尚未觉醒时，优先天籁琴音加速觉醒；已经觉醒后可考虑破境之证、众星拱月或增加人口的新生力量。众星拱月需要全场等级支撑，工具英雄等级低时收益有限。",
      "version": null,
      "condition": "刘邦尚未觉醒时",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
          "start": 1798.16,
          "end": 1911.45,
          "frame": "frames/1828-0.jpg"
        }
      ],
      "id": "claim-497378e542de10f8933a"
    },
    {
      "section": "第三轮拍卖",
      "text": "只有一张刘邦、其他英雄也各一张，且必须尽快觉醒时，作者提出卖掉其他英雄后用超级复印机集中复制刘邦、再补回图腾英雄的极端方案。它依赖能重新补齐组件，不作为常规操作。",
      "version": null,
      "condition": "只有一张刘邦",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "source": "BV1Jjao66ELh:p1",
