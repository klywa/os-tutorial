      "origin": "document"
    },
    {
      "id": "doc-5297b763cdb972b528ea72",
      "section": "后期运营及应变",
      "text": "第三轮竞拍可以拿扶摇直上、能量超新星、破镜之境，血量低就拿一线生机。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
