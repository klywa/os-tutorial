        }
      ],
      "origin": "document"
    },
    {
      "id": "doc-d5d5142d12de9bc097564b",
      "section": "中期运营及应变",
      "text": "第二轮拍卖优先级：海月（梭哈拿下）＞ 东皇 > 太乙真人 > 大司命",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
