  "claims": [
    {
      "id": "b22-b22-shield-liubang-owner-principle",
      "section": "核心原理",
      "text": "刘邦开团摧毁图腾取得临时等级，再靠高面板普攻、技能及扁鹊破盾补伤害。安琪拉飞行器持续输出，并把神秘力量转为连接英雄临时等级，明世隐可将部分临时等级变为永久等级；这让刘邦在取得首张后即可启动成长。飞行器需要连接对象存活，模块优先服务承伤、等级与持续输出，区别于一次性自爆路线。",
      "condition": "",
      "version": null,
