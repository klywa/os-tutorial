    {
      "type": "entry",
      "key": "集体唤醒",
      "show_key": true,
      "value": "登场成员在场时一起触发，提高明世隐等成员的收益；关键英雄未齐时先留资源找核心。",
      "prefix": "**",
      "key_suffix": "：** ",
