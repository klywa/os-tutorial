    {
      "id": "doc-30e1a350fc250b51a88f05",
      "section": "后期运营及应变",
      "text": "血量健康升棋手到6级，配合阿离的伞强化炸弹猫提升上限，棋手6级后，阿离技能选择\"枫之洪流“，首次转移后3秒内技能无限放。",
      "version": null,
      "condition": "",
      "inference": false,
      "kind": "conditional_strategy",
      "evidence": [
        {
          "type": "document",
