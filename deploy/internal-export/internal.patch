new file mode 100644
index 0000000000000000000000000000000000000000..1e725fb3f1ffca91a3c7208c72b282c6f4f38174
--- /dev/null
+++ b/frontend/test_internal_auth.py
@@ -0,0 +1,35 @@
+"""Account initialization and the authentication boundary shared by all clients."""
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'deploy'))
+from add_account import add_account
+from website_auth import Auth
+
+
+class InternalAccountTests(unittest.TestCase):
+    def test_roles_password_storage_and_logout(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / 'private/accounts.json'
+            auth = Auth(path, '', secure=False)
+            self.assertIsNone(auth.actor(''))
+            with self.assertRaises(ValueError):
+                add_account(path, 'viewer', 'reader', 'start-with-admin')
+            for role in ('admin', 'annotator', 'viewer'):
+                password = 'temporary-test-password-' + role
+                add_account(path, role, role, password)
+                self.assertNotIn(password, path.read_text(encoding='utf-8'))
+                code, cookie = auth.login(role, password, 'localhost')
+                self.assertEqual(code, 200)
+                self.assertEqual(auth.actor(cookie)['role'], role)
+                if role != 'admin':
+                    with self.assertRaises(PermissionError):
+                        auth.switch_role(cookie, 'admin')
+                auth.logout(cookie)
+                self.assertIsNone(Auth(path, '').actor(cookie))
+            self.assertTrue(all(row['password'].startswith('scrypt$')
+                                for row in json.loads(path.read_text(encoding='utf-8'))['accounts']))
