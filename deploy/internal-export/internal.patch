diff --git a/deploy/backup.py b/deploy/backup.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9c50ecc693660f1bdddfbd06eeb0727eccc2cff
--- /dev/null
+++ b/deploy/backup.py
@@ -0,0 +1,45 @@
+"""Make a private data backup of a stopped internal installation."""
+import argparse
+from contextlib import closing
+from pathlib import Path
+import os
+import shutil
+import sqlite3
+import tempfile
+
+DATA = ('knowledge', 'templates', 'website-data', 'entities', 'raw',
+        'knowledge-history', 'knowledge-sync', 'src/condition')
+
+
+def snapshot(root, destination):
+    root, destination = Path(root).resolve(), Path(destination).resolve()
+    if destination.is_relative_to(root) or destination.exists():
+        raise ValueError('请选择项目外尚不存在的备份目录')
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(dir=destination.parent) as temporary:
+        stage = Path(temporary) / 'data'
+        stage.mkdir(mode=0o700)
+        for relative in DATA:
+            source = root / relative
+            if not source.is_dir():
+                continue
+            target = stage / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copytree(source, target, symlinks=True,
+                            ignore=shutil.ignore_patterns('*.sqlite3', '*.sqlite3-shm', '*.sqlite3-wal'))
+            for database in source.rglob('*.sqlite3'):
+                if database.is_symlink() or not database.resolve().is_relative_to(root):
+                    raise ValueError('数据库必须位于项目目录内')
+                output = target / database.relative_to(source)
+                with closing(sqlite3.connect(database.as_uri()+'?mode=ro', uri=True)) as src:
+                    with closing(sqlite3.connect(output)) as dst:
+                        src.backup(dst)
+                os.chmod(output, 0o600)
+        stage.rename(destination)
+
+
+if __name__ == '__main__':
+    parser=argparse.ArgumentParser(description='停止服务后，将运行数据备份到新的目录')
+    parser.add_argument('destination', type=Path)
+    args=parser.parse_args()
+    snapshot(Path(__file__).resolve().parents[1], args.destination)
