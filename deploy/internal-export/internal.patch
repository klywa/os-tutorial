diff --git a/start.sh b/start.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2561e834373c5cf5a14556010d214b44bc059a0c
--- /dev/null
+++ b/start.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")"
+python_bin="${PYTHON:-python3}"
+if [[ -x .wxq-runtime/bin/python ]]; then python_bin=.wxq-runtime/bin/python; fi
+if ! command -v llama-server >/dev/null; then
+  for arg in "$@"; do
+    if [[ "$arg" == "--skip-topic-model" ]]; then exec "$python_bin" frontend/launch.py --no-browser "$@"; fi
+  done
+  engine=.wxq-runtime-engine
+  mkdir -p "$engine"
+  if [[ ! -d "$engine/source" ]]; then
+    git clone --branch b11712 --depth 1 https://github.com/ggml-org/llama.cpp.git "$engine/source"
+  fi
+  cmake -S "$engine/source" -B "$engine/build" -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DLLAMA_CURL=OFF
+  cmake --build "$engine/build" --config Release --target llama-server -j 2
+  export PATH="$PWD/$engine/build/bin:$PATH"
+fi
+exec "$python_bin" frontend/launch.py --no-browser "$@"
