diff --git a/frontend/internal_service.py b/frontend/internal_service.py
new file mode 100644
index 0000000000000000000000000000000000000000..d0ebddaaee84642ff237ff41723686f740c6e29a
--- /dev/null
+++ b/frontend/internal_service.py
@@ -0,0 +1,134 @@
+"""Authenticated LAN service with shared collaboration routes and administrator tools."""
+import os
+import socket
+import subprocess
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from website_server import configure, handler_class
+
+
+class OfflineSync:
+    def status(self, light=False):
+        return {'state': 'synced', 'message': '仅保存在内网服务器'}
+
+    def enqueue(self, force=False):
+        return self.status()
+
+
+def admin_route(path):
+    return (path in ('/api/annotations', '/api/sources', '/api/markdown-sync', '/api/dashboard/usage/refresh')
+            or path.startswith(('/api/crawler/', '/api/sources/', '/api/topics/', '/api/official-sync/',
+                                '/api/annotations/', '/api/markdown-sync/'))
+            or (path.startswith('/api/notes/') and '/versions' in path))
+
+
+def prepare_bundle(root):
+    """Restore omitted operational indexes from the verified distribution on first boot."""
+    import hashlib
+    import shutil
+    import json_store as store
+    from reference_store import normalize_cards, save_json_cards
+    from website_data import verify_package
+    from workspace import store_lock
+
+    manifest = verify_package(root)
+    bundle = root / 'website-data'
+    with store_lock(root, wait=True):
+        entity_paths = [p for p in manifest['files'] if p.startswith('entities/')]
+        for path in entity_paths:
+            if not (root / path).exists():
+                store.write_file(root / path, store.read(bundle / path))
+        snapshot = root / 'raw/lineup-usage/snapshot.json'
+        if not snapshot.exists():
+            store.write_file(snapshot, store.read(bundle / 'usage.json'))
+        card_index = root / 'knowledge/cards/index.meta.json'
+        image_index = root / 'entities/assets/index.json'
+        if card_index.exists() and image_index.exists():
+            return
+        entities = [item for path in entity_paths for item in store.read(bundle / path)]
+        if not card_index.exists():
+            published = {card['id']: card for card in store.read(bundle / 'cards.json')}
+            cards = [{**card, **published[card['id']]} for card in normalize_cards(entities)]
+            save_json_cards(root, cards)
+        if image_index.exists():
+            return
+        images = store.read(bundle / 'images.json')
+        index = {'version': 1, 'entities': {}, 'assets': {}}
+        image_index.parent.mkdir(parents=True, exist_ok=True)
+        for entity in entities:
+            props = entity.get('properties', {})
+            urls = {'thumb': props.get('thumb') or props.get('icon'),
+                    'image': props.get('cardImage') or props.get('image') or props.get('icon')}
+            for kind, digest in images['entities'].get(entity['id'], {}).items():
+                url = urls.get(kind)
+                key = hashlib.sha256(url.encode()).hexdigest() if url else digest
+                source_path = images['assets'][digest]['path']
+                if source_path not in manifest['files']:
+                    raise ValueError('卡牌图片不在已校验的发布清单中')
+                target = image_index.parent / (key + '.img')
+                if not target.exists():
+                    try:
+                        os.link(bundle / source_path, target)
+                    except OSError:
+                        temporary = target.with_suffix('.tmp')
+                        shutil.copyfile(bundle / source_path, temporary)
+                        os.replace(temporary, target)
+                index['assets'][key] = {'url': url or '', 'path': target.name}
+                index['entities'].setdefault(entity['id'], {})[kind] = key
+        store.write_file(image_index, index)
+
+
+def configure_server(root, port, start_worker, server_type, base):
+    from crawler import Runtime
+    import templates_http
+    import templates_store
+    from website_sync import SyncManager, SyncWorker
+
+    root = Path(root).resolve()
+    state = root / 'raw' / 'internal'
+    config = state / 'accounts.json'
+    origin = os.environ.get('WXQ_ORIGIN', f'http://{socket.gethostname()}:{port}').rstrip('/')
+    class InternalHandler(handler_class(base)):
+        def dispatch_admin(self, write):
+            if not self.trusted() or (write and self.headers.get('Origin') != self.server.public_origin):
+                return self.response(403, {'error': '请求来源无效'})
+            actor = self.actor()
+            if not actor:
+                return self.response(401, {'error': '请先登录'})
+            if actor['role'] != 'admin':
+                return self.response(403, {'error': '需要管理员权限'})
+            return base.mutate(self) if write else base.do_GET(self)
+
+        def do_GET(self):
+            if admin_route(urlsplit(self.path).path):
+                return self.dispatch_admin(False)
+            return super().do_GET()
+
+        def mutate(self):
+            if admin_route(urlsplit(self.path).path):
+                return self.dispatch_admin(True)
+            return super().mutate()
+
+    server = server_type((os.environ.get('WXQ_BIND', '0.0.0.0'), port), InternalHandler)
+    server.root = root
+    try:
+        prepare_bundle(root)
+        configure(server, '', origin, config, state)
+        branch = os.environ.get('WXQ_SYNC_BRANCH')
+        if branch:
+            checkout = subprocess.run(['git', '-C', str(root), 'rev-parse', '--show-toplevel'],
+                                      capture_output=True, text=True, check=True).stdout.strip()
+            if Path(checkout).resolve() != root:
+                raise ValueError('请先在内网项目目录建立独立 Git 仓库，再启用同步')
+        server.sync = SyncManager(root, state, branch) if branch else OfflineSync()
+        server.crawler = Runtime(root)
+        templates_store.refresh_published(root, entities=templates_http.effective_entities(server), migrate_events=True)
+        if start_worker:
+            if branch:
+                server.sync_worker = SyncWorker(server.sync).start()
+            server.crawler.start()
+        return server
+    except BaseException:
+        server.server_close()
+        raise
