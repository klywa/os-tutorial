          "id": "b77ae-h-877b3c4d69712e85d0"
        },
        {
          "type": "entry",
          "key": "自然法杖",
          "show_key": true,
          "value": "诸葛亮作为远程英雄，每消耗40点法力值，自然法杖会将随机1名敌人变成小猪，持续2秒。连续施法达到该消耗门槛后可补控制，触发马超的控制回蓝并帮助团队继续施法；不是每次施法或任意法力消耗都单独触发。",
          "prefix": "",
          "key_suffix": "：",
          "separator": "\n\n",
          "id": "b77-ae-020"
        },
