      "nodes": [
        {
          "type": "heading",
          "level": 1,
          "title": "三分诸葛亮-瑶妹",
          "space": " ",
          "separator": "\n\n",
          "id": "b77ae4-h-86217ada82be744efb"
        },
        {
          "type": "heading",
          "level": 2,
          "title": "核心原理",
          "space": " ",
          "separator": "\n\n",
          "id": "b77ae4-h-e06befdc1eeee4c0dc"
        },
        {
          "type": "entry",
          "key": "正文",
          "show_key": false,
          "value": "马超与诸葛亮共同承担输出。瑶妹小鹿的嘲讽、英雄瑶的眩晕等友军控制为马超提供法力与暴击，马超频繁突袭又为诸葛亮提供法力和临时等级；刘禅让施法英雄继续获得临时等级，明世隐把连线英雄的部分临时等级固化为永久成长。瑶与太乙真人保护马超，后期吕布给三分成员吸血，帮助输出存活并继续施法。小鹿奉献提供另一笔临时等级，须先让需要牺牲的工具阵亡，再由仍存活的输出接收。",
          "prefix": "",
          "key_suffix": "",
          "separator": "\n\n",
          "id": "b77-ae4-001"
        },
        {
          "type": "heading",
          "level": 2,
          "title": "打法评价",
