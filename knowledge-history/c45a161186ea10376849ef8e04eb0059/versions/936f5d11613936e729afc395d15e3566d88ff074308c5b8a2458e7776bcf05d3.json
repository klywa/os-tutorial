        },
        {
          "id": "g-6b80fd27bccb0e803962",
          "type": "heading",
          "level": 2,
          "title": "转型与投入",
          "space": " ",
          "separator": "\n\n"
        },
        {
          "id": "g-d68ac9bbb4de17aabcb2",
          "type": "entry",
          "key": "转型前保留等级转移手段",
          "show_key": true,
          "value": "准备转阵容、且场上已有不适合新阵容的高等级英雄时，提前留意可用的等级转移效果牌，避免换人时丢掉前期积累。具体接收目标和适用范围要按效果牌分别判断。",
          "separator": "\n\n"
        }
      ]
    },
